
# Application
NODE_ENV=
PORT=

# Production PostgreSQL
DATABASE_URL=

# Generate independent, strong production secrets
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# JWT expiry
JWT_ACCESS_EXPIRES_IN=
JWT_REFRESH_EXPIRES_IN=

# Frontend
CORS_ORIGIN=

# Cookie settings
COOKIE_HTTP_ONLY=
COOKIE_SECURE=
COOKIE_SAME_SITE=
COOKIE_DOMAIN=

# Cookie lifetime in milliseconds
ACCESS_COOKIE_MAX_AGE=
REFRESH_COOKIE_MAX_AGE=

# Cookie paths
ACCESS_COOKIE_PATH=/
REFRESH_COOKIE_PATH=/api/auth
